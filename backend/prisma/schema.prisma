generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String  @id @default(cuid())
  email             String  @unique
  password          String?
  googleId          String? @unique
  name              String
  preferredRecipeId String?
  createdAt         DateTime @default(now())

  guides Guide[]
}

model Guide {
  id                   String   @id @default(cuid())
  method               String
  nome                 String
  foco                 String
  moagem               String
  baseDose             Int
  tempoTotalEstimado   Int
  fases                Json
  authorId             String?
  author               User?    @relation(fields: [authorId], references: [id])
  createdAt            DateTime @default(now())
}
